<UserControl x:Class="BudgetTracker.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <StackPanel>
        <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Margin="0 0 0 16"/>

        <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
            <TextBlock Text="Month:" VerticalAlignment="Center" Margin="0 0 8 0"/>
            <TextBox Width="120" Text="{Binding SelectedMonth, UpdateSourceTrigger=PropertyChanged}" ToolTip="YYYY-MM"/>
        </StackPanel>

        <UniformGrid Columns="3" Margin="0 0 0 16">
            <Border Style="{StaticResource CardStyle}"><TextBlock Text="{Binding TotalIncome, StringFormat=Income: {0:N2}}"/></Border>
            <Border Style="{StaticResource CardStyle}"><TextBlock Text="{Binding TotalExpense, StringFormat=Expense: {0:N2}}"/></Border>
            <Border Style="{StaticResource CardStyle}"><TextBlock Text="{Binding NetBalance, StringFormat=Net: {0:N2}}"/></Border>
        </UniformGrid>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0 0 10 0">
                <lvc:CartesianChart Series="{Binding ExpenseByCategorySeries}" XAxes="{Binding XAxes}" Height="260"/>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <lvc:PieChart Series="{Binding IncomeVsExpenseSeries}" Height="260"/>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
