<UserControl x:Class="BudgetTracker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Margin="0 0 0 16"/>
        <CheckBox Content="Enable Dark Mode" IsChecked="{Binding IsDarkMode}" Margin="0 0 0 8"/>
        <Button Content="Apply Theme" Width="120" Command="{Binding ToggleThemeCommand}"/>
    </StackPanel>
</UserControl>
