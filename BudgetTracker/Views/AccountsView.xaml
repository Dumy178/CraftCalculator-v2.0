<UserControl x:Class="BudgetTracker.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Accounts" FontSize="28" FontWeight="Bold" Margin="0 0 0 16"/>
        <DataGrid ItemsSource="{Binding AccountBalances}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Account" Binding="{Binding AccountName}"/>
                <DataGridTextColumn Header="Income" Binding="{Binding Income, StringFormat=N2}"/>
                <DataGridTextColumn Header="Expense" Binding="{Binding Expense, StringFormat=N2}"/>
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N2}"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
