<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#FF121212</Color>
    <Color x:Key="CardColorValue">#FF1E1E1E</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="CardColor" Color="{StaticResource CardColorValue}"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
        <Setter Property="Foreground" Value="#F5F5F5"/>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardColor}"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
</ResourceDictionary>
